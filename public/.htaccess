<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Domaine canonique : www.bwanholding.com et bwantechnologies.com (avec ou sans www)
    # redirigent en 301 vers https://bwanholding.com. Les validations SSL (AutoSSL /
    # Let's Encrypt) ne sont pas redirigées. N'affecte pas localhost en développement.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^(www\.bwanholding\.com|(www\.)?bwantechnologies\.com)$ [NC]
    RewriteRule ^ https://bwanholding.com%{REQUEST_URI} [L,R=301]

    # Force HTTPS sur bwanholding.com
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^bwanholding\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://bwanholding.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
